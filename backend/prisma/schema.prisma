generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  HAIRDRESSER
  CUSTOMER
}

model User {
  id             String   @id @default(uuid())
  username       String   @unique
  email          String   @unique
  passwordHash   String
  phoneNumber    String?
  gender         String?
  address        String?
  avatar         String?
  role           Role     @default(CUSTOMER)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  createdServices Service[] @relation("ServiceCreatedBy")
  updatedServices Service[] @relation("ServiceUpdatedBy")
  deletedServices Service[] @relation("ServiceDeletedBy")

  workingSchedules WorkingSchedule[] @relation("HairdresserSchedules")

  @@map("users")
}

model Service {
  id            String    @id @default(uuid())
  name          String    @unique
  description   String?
  price         Float
  duration      Int
  imageUrl      String?
  isActive      Boolean   @default(true)

  createdAt     DateTime  @default(now())
  createdById   String?
  createdBy     User?     @relation("ServiceCreatedBy", fields: [createdById], references: [id])

  updatedAt     DateTime  @updatedAt
  updatedById   String?
  updatedBy     User?     @relation("ServiceUpdatedBy", fields: [updatedById], references: [id])

  deletedAt     DateTime?
  deletedById   String?
  deletedBy     User?     @relation("ServiceDeletedBy", fields: [deletedById], references: [id])

  @@map("services")
}

model WorkingSchedule {
  id             String   @id @default(uuid())
  hairdresserId  String
  hairdresser    User     @relation("HairdresserSchedules", fields: [hairdresserId], references: [id], onDelete: Cascade)
  dayOfWeek      Int      // 0 = Chủ nhật, 1 = Thứ 2, 2 = Thứ 3, ..., 6 = Thứ 7
  startTime      String   @default("08:00") // Định dạng "HH:mm" (ví dụ 08:00)
  endTime        String   @default("20:00") // Định dạng "HH:mm" (ví dụ 20:00)
  breakStartTime String?  @default("12:00") // Giờ bắt đầu nghỉ trưa "HH:mm"
  breakEndTime   String?  @default("14:00") // Giờ kết thúc nghỉ trưa "HH:mm"
  isDayOff       Boolean  @default(false)   // true = ngày nghỉ của thợ

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([hairdresserId, dayOfWeek])
  @@map("working_schedules")
}
