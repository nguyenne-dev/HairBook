generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  HAIRDRESSER
  CUSTOMER
}

model User {
  id             String   @id @default(uuid())
  username       String   @unique
  email          String   @unique
  passwordHash   String
  phoneNumber    String?
  gender         String?
  address        String?
  avatar         String?
  role           Role     @default(CUSTOMER)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  createdServices Service[] @relation("ServiceCreatedBy")
  updatedServices Service[] @relation("ServiceUpdatedBy")
  deletedServices Service[] @relation("ServiceDeletedBy")

  @@map("users")
}

model Service {
  id            String    @id @default(uuid())
  name          String    @unique
  description   String?
  price         Float
  duration      Int
  imageUrl      String?
  isActive      Boolean   @default(true)

  createdAt     DateTime  @default(now())
  createdById   String?
  createdBy     User?     @relation("ServiceCreatedBy", fields: [createdById], references: [id])

  updatedAt     DateTime  @updatedAt
  updatedById   String?
  updatedBy     User?     @relation("ServiceUpdatedBy", fields: [updatedById], references: [id])

  deletedAt     DateTime?
  deletedById   String?
  deletedBy     User?     @relation("ServiceDeletedBy", fields: [deletedById], references: [id])

  @@map("services")
}
